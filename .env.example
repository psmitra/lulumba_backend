APP_NAME=Lulumba
APP_ENV=development
APP_PORT=3000

# MongoDB - the connection URI is built in src/common/config/database.config.ts and opened in src/main.ts.
# Local:  MONGODB_HOST=localhost, MONGODB_PORT=27017, MONGODB_SRV=false
# Atlas:  MONGODB_HOST=cluster0.xxxxx.mongodb.net, MONGODB_SRV=true (port ignored)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_SRV=false
MONGODB_DATABASE=lulumba
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Optional query string, e.g. retryWrites=true&w=majority&authSource=admin
MONGODB_OPTIONS=
# Optional. Set (e.g. 8.8.8.8,1.1.1.1) if mongodb+srv fails with "querySrv ECONNREFUSED"
MONGODB_DNS_SERVERS=

# One of: fatal, error, warn, log, debug, verbose
LOG_LEVEL=debug
# Emit structured JSON logs (recommended when shipping logs to a collector)
LOG_JSON=false

# Written by `npx @nestjs/observe link`
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# ---- GhanaWorks SSO (OAuth 2.0) -----------------------------------------------
# Credentials come from GhanaWorks: php artisan sso:client "Lulumba" <redirect-uri> --logout-url=<api>/auth/backchannel-logout
GHANAWORKS_URL=https://ghanaworks.example.com
GHANAWORKS_CLIENT_ID=
# Server-side secret; never send it to the browser.
GHANAWORKS_CLIENT_SECRET=
# This API's callback, exactly as registered with GhanaWorks.
GHANAWORKS_REDIRECT_URI=http://localhost:3000/auth/callback

# The React app: users land here after login; the only CORS origin.
FRONTEND_URL=http://localhost:5173
# Keep true (browsers accept Secure cookies on http://localhost).
COOKIE_SECURE=true
# Reverse proxies in front of the API (1 behind a single load balancer).
TRUST_PROXY_HOPS=0
# Requests per minute per IP.
THROTTLE_LIMIT=120

# Development only (refused in production): `Authorization: Bearer <token>`
# acts as the dev user (GhanaWorks id 1024, Ama Mensah). Min 16 characters.
DEV_AUTH_TOKEN=

# ---- Storage (see src/modules/storage/README.md) ----------------------------
STORAGE_DRIVER=ftp
# Upload size limits in MB.
STORAGE_MAX_IMAGE_MB=10
STORAGE_MAX_VIDEO_MB=200
STORAGE_MAX_DOCUMENT_MB=20

# FTP / FTPS (not SFTP). FTP_SECURE: false | true (explicit FTPS) | implicit
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_SECURE=false
FTP_TIMEOUT=30000
FTP_ROOT_PATH=/lulumba
# Simultaneous FTP connections.
FTP_MAX_CONNECTIONS=4

# Public URL that serves FTP_ROOT_PATH (e.g. https://cdn.example.com/lulumba).
# Leave empty if files aren't publicly served: no public URLs are generated.
FTP_PUBLIC_BASE_URL=
