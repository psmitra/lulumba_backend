APP_NAME=Lulumba
APP_ENV=development
APP_PORT=3000

# MongoDB connection string (credentials and database name included). URL-encode
# special characters in the password.
# Local:   mongodb://localhost:27017/lulumba
# Atlas:   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/lulumba?retryWrites=true&w=majority
# Coolify: mongodb://root:pass@<container-name>:27017/lulumba?authSource=admin&directConnection=true
MONGODB_URI=mongodb://localhost:27017/lulumba
# Optional. Set (e.g. 8.8.8.8,1.1.1.1) if mongodb+srv fails with "querySrv ECONNREFUSED"
MONGODB_DNS_SERVERS=

# One of: fatal, error, warn, log, debug, verbose
LOG_LEVEL=debug
# Emit structured JSON logs (recommended when shipping logs to a collector)
LOG_JSON=false

# Written by `npx @nestjs/observe link`
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# ---- GhanaWorks SSO (OAuth 2.0) -----------------------------------------------
# Live: GHANAWORKS_URL=https://sumduma.com (no trailing slash; it is also the
# `iss` checked on back-channel logout tokens). Live only accepts https
# redirect URLs. Local: run GhanaWorks locally (e.g. http://localhost:8000)
# with its own client id/secret, so the live secret never sits on a laptop.
GHANAWORKS_URL=https://ghanaworks.example.com
GHANAWORKS_CLIENT_ID=
# Server-side secret; never send it to the browser.
GHANAWORKS_CLIENT_SECRET=
# This API's callback, exactly as registered with GhanaWorks.
# Live: https://api.lumumba.sumduma.com/api/v1/auth/callback
GHANAWORKS_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# Optional. Scopes requested at login (space-separated; must include profile).
# Default: profile users.read favorites.read favorites.write
GHANAWORKS_SCOPES=

# The React app: users land here after login; the only CORS origin.
FRONTEND_URL=http://localhost:5173
# Keep true (browsers accept Secure cookies on http://localhost).
COOKIE_SECURE=true
# Reverse proxies in front of the API (1 behind a single load balancer).
TRUST_PROXY_HOPS=0
# Requests per minute per IP.
THROTTLE_LIMIT=120

# Development only (refused in production): true makes /api/v1/auth/callback
# show the access and refresh tokens as JSON instead of redirecting to
# FRONTEND_URL, for testing the API with Swagger, Postman or curl.
DEV_SHOW_TOKENS=false

# ---- Storage (see src/common/storage/README.md) -----------------------------
# ftp (FTP/FTPS server) | local (a directory on this machine; development or a
# single server) | s3 (Amazon S3 or S3-compatible, e.g. Garage, MinIO).
# Only the chosen driver's settings below are read.
STORAGE_DRIVER=ftp
# Upload size limits in MB.
STORAGE_MAX_IMAGE_MB=10
STORAGE_MAX_VIDEO_MB=200
STORAGE_MAX_DOCUMENT_MB=20

# FTP / FTPS (not SFTP). FTP_SECURE: false | true (explicit FTPS) | implicit
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_SECURE=false
FTP_TIMEOUT=30000
FTP_ROOT_PATH=/lulumba
# Simultaneous FTP connections.
FTP_MAX_CONNECTIONS=4

# Public URL that serves FTP_ROOT_PATH (e.g. https://cdn.example.com/lulumba).
# Leave empty if files aren't publicly served: no public URLs are generated.
FTP_PUBLIC_BASE_URL=

# Development FTP server (`npm run ftp:dev`, see scripts/dev-ftp-server.mjs):
# serves this directory on FTP_HOST:FTP_PORT with FTP_USERNAME/FTP_PASSWORD,
# so FTP_HOST=127.0.0.1 works without installing an FTP server.
DEV_FTP_ROOT=

# Local disk (STORAGE_DRIVER=local). Absolute directory; created as needed.
# WAMP example: files served by Apache from d:\wamp64\www\lulumba-uploads
#   LOCAL_STORAGE_PATH=D:/wamp64/www/lulumba-uploads/lulumba
#   LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost/lulumba-uploads/lulumba
LOCAL_STORAGE_PATH=
LOCAL_STORAGE_PUBLIC_BASE_URL=

# S3 / S3-compatible (STORAGE_DRIVER=s3). Same names as Laravel's s3 disk.
# The key needs read + write on AWS_BUCKET
# (Garage: garage bucket allow --read --write <bucket> --key <key-id>).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Garage: garage. Amazon S3: the bucket's region, e.g. eu-west-1.
AWS_DEFAULT_REGION=
AWS_BUCKET=
# S3-compatible server URL; leave empty for Amazon S3.
AWS_ENDPOINT=
# true for Garage/MinIO (<endpoint>/<bucket>/<key>).
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public URL that serves the bucket's keys: <AWS_URL>/<key>. Empty = no
# public URLs.
AWS_URL=
